{
  "cells":[
    {"cell_type":"markdown","metadata":{},"source":["# 🦅 SAQR-100M — Real-data training\n","واجهة بسيطة داخل Colab: تجهيز البيانات → Tokenizer → تحويل tokens للقرص → تدريب SAQR → تجربة النموذج.\n"]},
    {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["!rm -rf /content/saqr-ai\n","!git clone --depth 1 https://github.com/majsjsj/saqr-ai.git /content/saqr-ai\n","%cd /content/saqr-ai\n","!pip install -q -r requirements.txt ipywidgets\n"]},
    {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["from pathlib import Path\n","import subprocess\n","from IPython.display import display\n","import ipywidgets as widgets\n","ROOT=Path('/content/saqr-ai')\n","if not ROOT.exists():\n","    subprocess.run('git clone --depth 1 https://github.com/majsjsj/saqr-ai.git /content/saqr-ai',shell=True,check=True)\n","    ROOT=Path('/content/saqr-ai')\n","LOG=widgets.Output(layout={'border':'1px solid #888','height':'260px','overflow_y':'auto'})\n","status=widgets.HTML('<b>الحالة:</b> 🟡 جاهز')\n","setup=widgets.Button(description='⚙️ تجهيز البيانات',button_style='primary')\n","train=widgets.Button(description='🧠 بدء التدريب',button_style='success')\n","test=widgets.Button(description='💬 تجربة SAQR',button_style='info')\n","prompt=widgets.Textarea(value='أنت SAQR. من أنت؟ وما الذي تستطيع فعله؟',layout=widgets.Layout(width='100%',height='80px'))\n","answer=widgets.Output(layout={'border':'1px solid #888','height':'180px','overflow_y':'auto'})\n","def run(cmd):\n","    p=subprocess.Popen(cmd,cwd=ROOT,shell=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1)\n","    for line in iter(p.stdout.readline,''):\n","        with LOG: print(line.rstrip())\n","    p.wait(); return p.returncode\n","def setup_click(_):\n","    setup.disabled=True; status.value='<b>الحالة:</b> 🟡 تجهيز...'\n","    try:\n","        data=ROOT/'data/train.txt'; tokenbin=ROOT/'data/tokens.bin'\n","        if not data.exists():\n","            url='https://api.researchdata.se/dataset/2024-145/1/file/zip'\n","            run(f\"curl -L --fail --retry 3 '{url}' -o /tmp/hindawi.zip\")\n","            run('mkdir -p data/hindawi && unzip -q -o /tmp/hindawi.zip -d data/hindawi')\n","            files=sorted((ROOT/'data/hindawi').rglob('*.txt'))\n","            with open(data,'w',encoding='utf-8') as out:\n","                for p in files:\n","                    try:\n","                        t=p.read_text(encoding='utf-8',errors='ignore')\n","                        if t.strip(): out.write('\\n\\n'+t)\n","                    except Exception: pass\n","            with LOG: print('📚 TXT files:',len(files))\n","        if not (ROOT/'tokenizer/tokenizer.json').is_file():\n","            run('python tokenizer.py --input data/train.txt --output tokenizer --vocab-size 32000')\n","        if not tokenbin.exists():\n","            run('python prepare_tokens.py --input data/train.txt --tokenizer tokenizer/tokenizer.json --output data/tokens.bin')\n","        status.value='<b>الحالة:</b> 🟢 البيانات جاهزة للتدريب'\n","    except Exception as e:\n","        status.value='<b>الحالة:</b> 🔴 خطأ';\n","        with LOG: print(e)\n","    setup.disabled=False\n","def train_click(_):\n","    setup.disabled=True; train.disabled=True; status.value='<b>الحالة:</b> 🔥 SAQR يتدرب...'\n","    code=run('python train.py --config configs/saqr_100m.json --data data/tokens.bin --tokenizer tokenizer/tokenizer.json')\n","    status.value='<b>الحالة:</b> 🟢 اكتمل التدريب' if code==0 else '<b>الحالة:</b> 🔴 فشل التدريب'\n","    setup.disabled=False; train.disabled=False\n","def test_click(_):\n","    answer.clear_output()\n","    if not (ROOT/'checkpoints/last.pt').exists():\n","        with answer: print('❌ لا يوجد checkpoint. درّب SAQR أولًا.')\n","        return\n","    q=prompt.value.replace('\\"','\\\\\\"')\n","    r=subprocess.run(f'python generate.py --checkpoint checkpoints/last.pt --tokenizer tokenizer/tokenizer.json --prompt "{q}" --tokens 120',cwd=ROOT,shell=True,capture_output=True,text=True)\n","    with answer: print(r.stdout or r.stderr)\n","setup.on_click(setup_click); train.on_click(train_click); test.on_click(test_click)\n","display(widgets.HTML('<h1>🦅 SAQR AI</h1>'),status,widgets.HBox([setup,train,test]),prompt,answer,widgets.HTML('<h3>📜 سجل العمليات</h3>'),LOG)\n"]},
    {"cell_type":"markdown","metadata":{},"source":["### ملاحظة\n","التدريب يبدأ من أوزان عشوائية. البيانات الحقيقية تُحمّل تلقائيًا، والـtokens تُخزن على القرص بدل تحميلها كلها في RAM. يلزم تشغيل Colab على GPU لتدريب عملي.\n"]}
